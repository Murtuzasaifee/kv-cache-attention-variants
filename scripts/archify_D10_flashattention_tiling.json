  "cards": [
    { "dot": "rose", "title": "Naive Bottleneck", "items": ["Full Q@K^T written to slow HBM every step", "O(n²) memory traffic on the attention matrix", "Compute itself is fast — data movement is the bottleneck"] },
    { "dot": "emerald", "title": "FlashAttention", "items": ["Tiles Q, K, V into SRAM-sized blocks", "Streaming softmax writes one block at a time", "O(n) HBM reads, mathematically identical output"] },
    { "dot": "cyan", "title": "Why It Matters", "items": ["2–8x speedup on long sequences", "Same answer, often lower memory peak", "Default in PyTorch SDPA when supported"] }
